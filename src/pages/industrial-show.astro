---
import Layout from '../layouts/Layout.astro';

// DANH SÁCH TẬP ĐOÀN CÔNG NGHỆ (ĐÃ BỎ PHẦN MÔ TẢ)
const enterprisePartners = [
  {
    title: "Tập đoàn Viettel",
    logo: "/logos/logo-vt.jpg",
    fallbackLogo: "/logos/logo-vt.jpg",
    badges: [
      { text: "🥇 Tài trợ Vàng", class: "bg-amber-100 text-amber-900 border-amber-300 font-black" },
      //{ text: "🎪 Showcase", class: "bg-blue-100 text-blue-800 border-blue-200" }
    ]
  },
  {
    title: "Tập đoàn FPT",
    logo: "/logos/FPT_logo.png",
    fallbackLogo: "/logos/FPT_logo.png",
    badges: [
      { text: "🤝 Nhà tài trợ kim cương", class: "bg-orange-100 text-orange-900 border-orange-300 font-bold" },
      { text: "🎪 Showcase", class: "bg-blue-100 text-blue-800 border-blue-200" }
    ]
  },
  {
    title: "Tập đoàn CMC",
    logo: "/logos/cmc_logo.png",
    fallbackLogo: "/logos/cmc_logo.png",
    badges: [
      { text: "🤝 Nhà tài trợ", class: "bg-cyan-100 text-cyan-900 border-cyan-300 font-bold" },
      { text: "🎪 Showcase", class: "bg-blue-100 text-blue-800 border-blue-200" }
    ]
  }
];
---

<Layout title="Industrial Show - AI4Econ&Biz 2026">
  <main class="bg-slate-50 font-sans text-slate-900 cursor-default py-10 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <div class="border-b-2 border-slate-900 pb-3 mb-8 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
        <h1 class="text-2xl font-black text-blue-950 uppercase tracking-tight">
          💼 Industrial Show 2026
        </h1>
        <p class="text-xs font-bold text-orange-600 uppercase tracking-widest">
          Hợp tác Doanh nghiệp & Triển khai Công nghệ
        </p>
      </div>

      <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm mb-8 grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
        <div class="md:col-span-2 space-y-2">
          <span class="bg-slate-100 text-slate-800 font-bold text-[9px] uppercase tracking-widest px-2 py-0.5 rounded border border-slate-200">
            Tổ chức tại Đại học Ngoại thương
          </span>
          <p class="text-xs md:text-sm text-slate-600 leading-relaxed text-justify">
            Diễn ra song song với hội thảo khoa học, không gian triển lãm <strong>Industrial Show</strong> thuộc chuỗi sự kiện <strong>AI4Econ&Biz 2026</strong> là diễn đàn giao thương cấp cao. Đây là sáng kiến được thiết kế riêng cho các tập đoàn, startup công nghệ và doanh nghiệp nhằm thu hẹp khoảng cách giữa nghiên cứu học thuật xuất sắc với các ứng dụng thực tiễn trong nền công nghiệp.
          </p>
        </div>
        
        <div class="bg-slate-900 text-white p-4 rounded-xl text-center space-y-2 border border-slate-800 shadow">
          <p class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider">Đăng ký gian hàng</p>
          <p class="text-xs font-medium text-slate-300">Số lượng vị trí trưng bày có hạn dành cho các đối tác doanh nghiệp.</p>
          <a href="mailto:conference@ftu.edu.vn" class="inline-block bg-orange-500 hover:bg-orange-600 text-white text-[11px] font-bold uppercase tracking-wider px-4 py-2 rounded shadow-sm w-full transition-all text-center">
            Liên hệ đặt gian hàng
          </a>
        </div>
      </div>

      <!-- KHỐI 3 TẬP ĐOÀN CÔNG NGHỆ: THỨ TỰ TÊN -> LOGO -> BADGES -->
      <div class="space-y-4">
        <h2 class="text-xs font-bold text-slate-400 uppercase tracking-widest">
          Tập đoàn Công nghệ Tài trợ & Gian hàng Trưng bày (Showcase)
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {enterprisePartners.map((item) => (
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:border-blue-900 hover:shadow-md transition-all flex flex-col justify-between items-center text-center group">
              <div class="space-y-4 w-full flex flex-col items-center">
                
                <!-- 1. TÊN CÔNG TY TÀI TRỢ -->
                <h3 class="text-base font-extrabold text-blue-950 tracking-tight group-hover:text-orange-600 transition-colors">
                  {item.title}
                </h3>

                <!-- 2. LOGO CÔNG TY -->
                <div class="w-full h-20 bg-slate-50 border border-slate-100 rounded-xl p-2.5 flex items-center justify-center overflow-hidden group-hover:bg-white transition-colors">
                  <img 
                    src={item.logo} 
                    alt={`Logo ${item.title}`} 
                    class="max-h-full max-w-full object-contain"
                    onerror={`this.src='${item.fallbackLogo}';`}
                  />
                </div>

                <!-- 3. TAG LOẠI NHÀ TÀI TRỢ & SHOWCASE -->
                <div class="flex flex-wrap items-center justify-center gap-1.5 pt-1">
                  {item.badges.map((badge) => (
                    <span class={`border font-bold text-[9px] uppercase tracking-wider px-2 py-0.5 rounded-md ${badge.class}`}>
                      {badge.text}
                    </span>
                  ))}
                </div>

              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- KHỐI MẠNG LƯỚI CHIẾN LƯỢC -->
      <div class="mt-8 bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="space-y-0.5">
            <h3 class="text-xs font-bold text-blue-950 uppercase tracking-wider">Mạng lưới công nghệ chiến lược</h3>
            <p class="text-[11px] text-slate-500 italic">Kết nối tri thức học thuật với các tổ chức công nghệ hàng đầu và cộng đồng doanh nghiệp vĩ mô.</p>
          </div>
          <div class="flex items-center gap-4 border-t sm:border-t-0 sm:border-l border-slate-100 pt-3 sm:pt-0 sm:pl-4 shrink-0">
            <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-widest">Đồng hành cùng</span>
            <div class="font-black text-sm text-slate-300 tracking-tighter uppercase select-none">
              FISU <span class="text-orange-500">VIỆT NAM</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
</Layout>